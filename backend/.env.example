# Copy this file to .env in the same folder, then fill in real values.
# .env is gitignored — never commit real credentials.

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API.
# During local dev with Live Server this is usually http://127.0.0.1:5500
# In production, set it to your real frontend domain, e.g. https://tdmotors.in
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5500,http://localhost:5500

# Shared password for the /admin dashboard. Pick something long and random.
ADMIN_PASSWORD=change-me-before-deploying

# Secret used to sign admin login tokens (JWTs). Must be at least 16
# characters, and unique per deployment — never reuse this value or share
# it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=change-me-generate-a-real-random-secret

# How long an admin login stays valid before requiring a fresh login.
# Format: a number + s/m/h/d (e.g. "12h", "7d"). Default: 12h.
ADMIN_JWT_EXPIRES_IN=12h

# --- Postgres (inquiries and inventory are stored here) ---
# Schema is created/updated automatically on startup by running the SQL
# files in backend/migrations/ (see src/migrate.js) — you just need the
# database itself to exist first (createdb td_motors, or via psql/DBeaver).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=td_motors
DB_USER=postgres
DB_PASSWORD=your-postgres-password

# --- SMTP (for sending inquiry emails) ---
# Gmail App Password works fine for development/testing (see below), but
# for a real production launch, a transactional email provider — SendGrid,
# Postmark, Amazon SES — is more reliable and gives you delivery tracking.
# All of them support this exact same SMTP interface, so switching later
# only means changing these five values, no code changes.
#
# Gmail example: create the account, turn on 2-Step Verification, then
# generate an "App Password" at myaccount.google.com/apppasswords and use
# that here — NOT the account's normal login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-business-gmail@gmail.com
SMTP_PASS=your-16-character-app-password

# Where inquiry emails are delivered. Defaults to SMTP_USER if left blank.
BUSINESS_EMAIL=enquiries@tdmotors.in

# Where uploaded car photos are stored. Default: backend/uploads. In Docker/production point this at a
# persistent volume so photos survive redeploys.
# UPLOAD_DIR=/data/uploads
